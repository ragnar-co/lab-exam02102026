# Runtime inputs (no secrets here). Approved reference_date lives in config/runtime_config.json; set CPD_REFERENCE_DATE only to override.
CPD_REFERENCE_DATE=
CPD_RUNS_DIR=runs
CPD_MASK_IDENTIFIERS=false

# Optional AI bonus (values come from Coolify secrets; never commit them)
CPD_AI_ENDPOINT_URL=
CPD_AI_API_KEY=
CPD_AI_MODEL=
CPD_AI_TIMEOUT_SECONDS=
CPD_AI_AUTH_HEADER=
